# Unidad systemd del agente de PLC-Monitor.
# Instalación: ver docs/manual/es/agente.md (sección «Instalar como servicio»).
[Unit]
Description=PLC-Monitor Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=plcmon
Group=plcmon
WorkingDirectory=/opt/plc-monitor/agent
ExecStart=/opt/plc-monitor/agent/plcmon-agent
Restart=on-failure
RestartSec=5
# Endurecimiento: el agente solo necesita red y su carpeta.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/plc-monitor/agent

[Install]
WantedBy=multi-user.target
