<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:PlcMonitor.App.Localization"
             xmlns:vm="using:PlcMonitor.App.ViewModels"
             xmlns:c="using:PlcMonitor.App.Controls"
             x:Class="PlcMonitor.App.Views.TransformsView"
             x:DataType="vm:TransformsViewModel"
             Background="{DynamicResource App.Background}">
  <Grid ColumnDefinitions="270,*" Margin="20,16" ColumnSpacing="16">

    <!-- Lista de transformaciones -->
    <Border Classes="card" Padding="12">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,0,0,10">
          <TextBlock Text="{loc:T 'TRANSFORMACIONES'}" Classes="caption" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost" Command="{Binding AddCommand}" ToolTip.Tip="{loc:T 'Nueva transformación'}">
            <c:Icon Kind="plus" />
          </Button>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="4,8" IsVisible="{Binding IsEmpty}"
                   Text="{loc:T 'Aún no hay transformaciones. Crea una con «+».'}" />
        <ListBox Classes="devices" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TransformItem">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding UsageSummary}" Classes="muted" FontSize="11.5" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Detalle de la transformación seleccionada -->
    <DockPanel Grid.Column="1">
      <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,14">
        <TextBlock Text="{loc:T 'Transformaciones'}" Classes="title" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="{loc:T 'Muestran valores enteros como texto (0 = Parado, 1 = Marcha…). Se guardan en el agente y se asignan a cada tag en su detalle (doble clic → «Mostrar valor como»).'}" />
      </StackPanel>

      <!-- Guardar / descartar -->
      <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
        <Border Classes="card" Padding="12" IsVisible="{Binding Errors, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Kind="alert" Width="14" Height="14" Foreground="{DynamicResource App.Bad}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <TextBlock Text="{Binding Errors}" Classes="error" TextWrapping="Wrap" MaxWidth="760" />
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <TextBlock Text="{loc:T 'Cambios sin guardar'}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding IsDirty}" Margin="0,0,8,0" />
          <Button Classes="secondary" Command="{Binding DiscardCommand}" Content="{loc:T 'Descartar'}" />
          <Button Classes="accent" Command="{Binding SaveCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="save" />
              <TextBlock Text="{loc:T 'Guardar en el agente'}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>

      <ScrollViewer>
        <Border Classes="card" Padding="20" DataContext="{Binding Selected}" x:DataType="vm:TransformItem"
                IsVisible="{Binding $parent[UserControl].((vm:TransformsViewModel)DataContext).HasSelection}">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="150,*,Auto" ColumnSpacing="16">
              <TextBlock Text="{loc:T 'Nombre'}" VerticalAlignment="Center" FontWeight="Medium" />
              <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="{loc:T 'Estado del motor'}" />
              <Button Grid.Column="2" Classes="ghost danger" ToolTip.Tip="{loc:T 'Borrar transformación'}"
                      Command="{Binding $parent[UserControl].((vm:TransformsViewModel)DataContext).RemoveCommand}">
                <c:Icon Kind="trash" />
              </Button>
            </Grid>
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap">
              <Run Text="{loc:T 'La usa: '}" /><Run Text="{Binding UsageText}" />
            </TextBlock>

            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="140,24,*,Auto" ColumnSpacing="8" Classes="tablehead">
                <TextBlock Text="{loc:T 'VALOR'}" />
                <TextBlock Grid.Column="2" Text="{loc:T 'SE MUESTRA COMO'}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TransformEntryItem">
                    <Grid ColumnDefinitions="140,24,*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                      <TextBox Text="{Binding Value}" Classes="mono" PlaceholderText="0" />
                      <TextBlock Grid.Column="1" Text="=" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBox Grid.Column="2" Text="{Binding Text}" PlaceholderText="{loc:T 'Parado'}" />
                      <Button Grid.Column="3" Classes="ghost danger" ToolTip.Tip="{loc:T 'Quitar valor'}"
                              Command="{Binding $parent[ItemsControl].((vm:TransformItem)DataContext).RemoveEntryCommand}" CommandParameter="{Binding}">
                        <c:Icon Kind="x" Width="14" Height="14" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="secondary" Command="{Binding AddEntryCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="plus" Width="14" Height="14" />
                  <TextBlock Text="{loc:T 'Añadir valor'}" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="{loc:T 'Los booleanos cuentan como 0 (false) y 1 (true). Un valor que no está en la lista se muestra tal cual. Las filas sin texto no se guardan.'}" />
          </StackPanel>
        </Border>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
