<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:PlcMonitor.App.Controls">

  <!-- Tokens de color: un acento, superficies neutras y cuatro colores de estado -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="App.Background" Color="#F4F6F9" />
          <SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
          <SolidColorBrush x:Key="App.SurfaceAlt" Color="#F1F4F8" />
          <SolidColorBrush x:Key="App.SurfaceHover" Color="#EEF2F7" />
          <SolidColorBrush x:Key="App.Border" Color="#E2E6EC" />
          <SolidColorBrush x:Key="App.Text" Color="#18202B" />
          <SolidColorBrush x:Key="App.TextMuted" Color="#667085" />
          <SolidColorBrush x:Key="App.Accent" Color="#2563EB" />
          <SolidColorBrush x:Key="App.AccentSoft" Color="#E8EFFD" />
          <SolidColorBrush x:Key="App.AccentText" Color="#1D4ED8" />
          <SolidColorBrush x:Key="App.Good" Color="#15803D" />
          <SolidColorBrush x:Key="App.GoodSoft" Color="#DCFCE7" />
          <SolidColorBrush x:Key="App.Warn" Color="#B45309" />
          <SolidColorBrush x:Key="App.WarnSoft" Color="#FEF3C7" />
          <SolidColorBrush x:Key="App.Bad" Color="#DC2626" />
          <SolidColorBrush x:Key="App.BadSoft" Color="#FEE2E2" />
          <!-- Series de las gráficas -->
          <SolidColorBrush x:Key="App.Chart0" Color="#2563EB" />
          <SolidColorBrush x:Key="App.Chart1" Color="#EA580C" />
          <SolidColorBrush x:Key="App.Chart2" Color="#16A34A" />
          <SolidColorBrush x:Key="App.Chart3" Color="#9333EA" />
          <SolidColorBrush x:Key="App.Chart4" Color="#0891B2" />
          <SolidColorBrush x:Key="App.Chart5" Color="#DB2777" />
          <SolidColorBrush x:Key="App.Chart6" Color="#CA8A04" />
          <SolidColorBrush x:Key="App.Chart7" Color="#475569" />
          <SolidColorBrush x:Key="App.Neutral" Color="#64748B" />
          <SolidColorBrush x:Key="App.NeutralSoft" Color="#EEF1F5" />
          <BoxShadows x:Key="App.Shadow">0 1 2 0 #0F172A14, 0 1 3 0 #0F172A0D</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="App.Background" Color="#0F1115" />
          <SolidColorBrush x:Key="App.Surface" Color="#171A20" />
          <SolidColorBrush x:Key="App.SurfaceAlt" Color="#1D2129" />
          <SolidColorBrush x:Key="App.SurfaceHover" Color="#232833" />
          <SolidColorBrush x:Key="App.Border" Color="#2A2F3A" />
          <SolidColorBrush x:Key="App.Text" Color="#E7EAF0" />
          <SolidColorBrush x:Key="App.TextMuted" Color="#9099A8" />
          <SolidColorBrush x:Key="App.Accent" Color="#3B82F6" />
          <SolidColorBrush x:Key="App.AccentSoft" Color="#1B2A45" />
          <SolidColorBrush x:Key="App.AccentText" Color="#93B8FB" />
          <SolidColorBrush x:Key="App.Good" Color="#4ADE80" />
          <SolidColorBrush x:Key="App.GoodSoft" Color="#163322" />
          <SolidColorBrush x:Key="App.Warn" Color="#FBBF24" />
          <SolidColorBrush x:Key="App.WarnSoft" Color="#3A2E12" />
          <SolidColorBrush x:Key="App.Bad" Color="#F87171" />
          <SolidColorBrush x:Key="App.BadSoft" Color="#3B1C1F" />
          <!-- Series de las gráficas -->
          <SolidColorBrush x:Key="App.Chart0" Color="#60A5FA" />
          <SolidColorBrush x:Key="App.Chart1" Color="#FB923C" />
          <SolidColorBrush x:Key="App.Chart2" Color="#4ADE80" />
          <SolidColorBrush x:Key="App.Chart3" Color="#C084FC" />
          <SolidColorBrush x:Key="App.Chart4" Color="#22D3EE" />
          <SolidColorBrush x:Key="App.Chart5" Color="#F472B6" />
          <SolidColorBrush x:Key="App.Chart6" Color="#FACC15" />
          <SolidColorBrush x:Key="App.Chart7" Color="#94A3B8" />
          <SolidColorBrush x:Key="App.Neutral" Color="#94A3B8" />
          <SolidColorBrush x:Key="App.NeutralSoft" Color="#232833" />
          <BoxShadows x:Key="App.Shadow">0 1 2 0 #00000040</BoxShadows>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Base -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource App.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="FontFamily" Value="fonts:Inter#Inter, $Default" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource App.Bad}" />
  </Style>

  <!-- Tarjetas y barras -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BoxShadow" Value="{DynamicResource App.Shadow}" />
  </Style>
  <Style Selector="Border.bar">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
  </Style>
  <Style Selector="Border.brand">
    <Setter Property="Background" Value="{DynamicResource App.Accent}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
  </Style>

  <!-- Pastillas de estado y calidad -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="9,2" />
    <Setter Property="Background" Value="{DynamicResource App.NeutralSoft}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource App.Neutral}" />
  </Style>
  <Style Selector="Border.pill.good">
    <Setter Property="Background" Value="{DynamicResource App.GoodSoft}" />
  </Style>
  <Style Selector="Border.pill.good TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource App.Good}" />
  </Style>
  <Style Selector="Border.pill.warn">
    <Setter Property="Background" Value="{DynamicResource App.WarnSoft}" />
  </Style>
  <Style Selector="Border.pill.warn TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource App.Warn}" />
  </Style>
  <Style Selector="Border.pill.bad">
    <Setter Property="Background" Value="{DynamicResource App.BadSoft}" />
  </Style>
  <Style Selector="Border.pill.bad TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource App.Bad}" />
  </Style>
  <Style Selector="Border.pill.accent">
    <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
  </Style>
  <Style Selector="Border.pill.accent TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource App.AccentText}" />
  </Style>
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource App.Neutral}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Ellipse.dot.good">
    <Setter Property="Fill" Value="{DynamicResource App.Good}" />
  </Style>
  <Style Selector="Ellipse.dot.warn">
    <Setter Property="Fill" Value="{DynamicResource App.Warn}" />
  </Style>
  <Style Selector="Ellipse.dot.bad">
    <Setter Property="Fill" Value="{DynamicResource App.Bad}" />
  </Style>

  <!-- Botones: primario (acento), secundario (borde) y fantasma (solo icono) -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.SurfaceHover}" />
  </Style>
  <Style Selector="Button.danger:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource App.Bad}" />
  </Style>
  <!-- Deshabilitados: el mismo aspecto, atenuado (no el bloque gris de Fluent) -->
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.secondary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Accent}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <!-- Selector segmentado (true/false): el segmento encendido va con el color de acento -->
  <Style Selector="Button.seg">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinWidth" Value="58" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.seg.left">
    <Setter Property="CornerRadius" Value="7,0,0,7" />
  </Style>
  <Style Selector="Button.seg.right">
    <Setter Property="CornerRadius" Value="0,7,7,0" />
    <Setter Property="Margin" Value="-1,0,0,0" />
  </Style>
  <Style Selector="Button.seg.on /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button c|Icon">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Lista de dispositivos: tarjetas con selección suave -->
  <Style Selector="ListBox.devices">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.devices ListBoxItem">
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.devices ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.SurfaceHover}" />
  </Style>
  <Style Selector="ListBox.devices ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
  </Style>
  <Style Selector="ListBox.devices ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
  </Style>

  <!-- Tablas (tags, resultados): filas con separador y hover, sin selección llamativa -->
  <Style Selector="ListBox.table">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem">
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.SurfaceHover}" />
  </Style>
  <!-- Ventana estrecha: los botones de la barra superior se quedan con el icono -->
  <Style Selector="Window.narrow TextBlock.barlabel">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=".tablehead TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>

  <!-- Pestañas compactas -->
  <Style Selector="TabControl.compact">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabControl.compact TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="2,0,18,0" />
  </Style>

  <!-- Campos -->
  <Style Selector="TextBox, AutoCompleteBox, ComboBox, NumericUpDown">
    <Setter Property="CornerRadius" Value="7" />
  </Style>
</Styles>
