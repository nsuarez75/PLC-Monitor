<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:PlcMonitor.App.Localization"
             xmlns:ch="using:PlcMonitor.App.Charts"
             xmlns:c="using:PlcMonitor.App.Controls"
             xmlns:v="using:PlcMonitor.App.Views"
             x:Class="PlcMonitor.App.Views.ChartPanel"
             x:DataType="ch:ChartViewModel">
  <!-- Gráfica con sus controles: tags a mostrar, límites del eje Y, zoom (arrastrar sobre la gráfica; «Ajustar» lo quita),
       estadísticas de la ventana y exportar la imagen. -->
  <Panel>
  <!-- Aquí se monta un momento la imagen que se exporta (tamaño cero: no se ve). -->
  <Canvas x:Name="ExportHost" Width="0" Height="0" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top" />
  <DockPanel>
    <!-- Tags y controles en una línea; si no caben (p. ej. en un panel), los controles pasan debajo. -->
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" ItemSpacing="16" LineSpacing="6">
      <ItemsControl ItemsSource="{Binding Options}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="ch:ChartSeriesOption">
            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,14,0">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <c:ChartSwatch ColorIndex="{Binding ColorIndex}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </StackPanel>
            </CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <CheckBox Content="{loc:T 'Cursores'}" IsChecked="{Binding ShowCursors}" IsVisible="{Binding IsTrend}"
                  ToolTip.Tip="{loc:T 'Dos cursores, A y B, para medir el tiempo entre dos instantes y cuánto cambia cada tag'}" />
        <CheckBox Content="{loc:T 'Un eje por tag'}" IsChecked="{Binding SeparateAxes}" IsVisible="{Binding CanSeparateAxes}"
                  ToolTip.Tip="{loc:T 'Cada tag con su propia escala, a la izquierda y con su color'}" />
        <CheckBox Content="{Binding AxisText}" IsChecked="{Binding AutoY}" IsVisible="{Binding HasYAxis}" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsManualY" />
              <Binding Path="HasYAxis" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{loc:T 'mín'}" Classes="muted" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding YMinInput}" Width="120" FormatString="0.###" Increment="1" />
          <TextBlock Text="{loc:T 'máx'}" Classes="muted" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding YMaxInput}" Width="120" FormatString="0.###" Increment="1" />
        </StackPanel>
        <Button Classes="secondary" Command="{Binding ResetZoomCommand}" IsVisible="{Binding IsZoomed}" ToolTip.Tip="{loc:T 'Quitar el zoom y ver toda la ventana'}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Kind="maximize" />
            <TextBlock Text="{loc:T 'Ajustar'}" />
          </StackPanel>
        </Button>
        <CheckBox Content="{loc:T 'Estadísticas'}" IsChecked="{Binding ShowStats}" IsVisible="{Binding CanShowStats}"
                  ToolTip.Tip="{loc:T 'Mín, máx, media ponderada en el tiempo, σ y más de cada tag en la ventana que se ve (con el zoom)'}" />
        <Button x:Name="SavePng" Classes="ghost" ToolTip.Tip="{loc:T 'Exportar la gráfica a PNG (con título, periodo y leyenda, fondo blanco)'}">
          <c:Icon Kind="image" />
        </Button>
        <Button x:Name="CopyPng" Classes="ghost" ToolTip.Tip="{loc:T 'Copiar la imagen de la gráfica al portapapeles'}">
          <c:Icon Kind="copy" />
        </Button>
      </StackPanel>
    </WrapPanel>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="2,4,0,0">
      <TextBlock Classes="muted" FontSize="11" Text="{Binding Hint}" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Classes="muted" Classes.error="{Binding CaptionAlarm}" FontSize="11" FontWeight="SemiBold" Text="{Binding Caption}" />
    </Grid>
    <!-- Estadísticas de los tags marcados en la ventana visible -->
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,8,0,0" Padding="0,0,0,6" IsVisible="{Binding StatsVisible}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,8,8,4">
          <TextBlock Text="{loc:T 'ESTADÍSTICAS DE LA VENTANA VISIBLE'}" Classes="muted" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button x:Name="CopyStats" Classes="ghost" ToolTip.Tip="{loc:T 'Copiar la tabla (para pegarla en una hoja de cálculo)'}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Kind="copy" />
                <TextBlock Text="{loc:T 'Copiar'}" />
              </StackPanel>
            </Button>
            <Button x:Name="SaveStats" Classes="ghost" ToolTip.Tip="{loc:T 'Guardar las estadísticas en un CSV'}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Kind="download" />
                <TextBlock Text="CSV" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="200">
          <StackPanel Margin="12,0">
            <Grid Classes="tablehead" ColumnDefinitions="180,170,170,120,90,100,100,90,80,70" ColumnSpacing="10" Margin="0,2,0,4">
              <TextBlock Text="{loc:T 'TAG'}" />
              <TextBlock Grid.Column="1" Text="{loc:T 'MÍN'}" />
              <TextBlock Grid.Column="2" Text="{loc:T 'MÁX'}" />
              <TextBlock Grid.Column="3" Text="{loc:T 'MEDIA'}" />
              <TextBlock Grid.Column="4" Text="σ" />
              <TextBlock Grid.Column="5" Text="{loc:T 'PRIMERO'}" />
              <TextBlock Grid.Column="6" Text="{loc:T 'ÚLTIMO'}" />
              <TextBlock Grid.Column="7" Text="Δ" />
              <TextBlock Grid.Column="8" Text="{loc:T 'MUESTRAS'}" />
              <TextBlock Grid.Column="9" Text="{loc:T 'FLANCOS ↑'}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Stats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ch:SeriesStatsRow">
                  <Grid ColumnDefinitions="180,170,170,120,90,100,100,90,80,70" ColumnSpacing="10" Margin="0,2">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <c:ChartSwatch ColorIndex="{Binding ColorIndex}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="mono" FontSize="12" Text="{Binding MinText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Classes="mono" FontSize="12" Text="{Binding MaxText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Classes="mono" FontSize="12" Text="{Binding MeanText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Classes="mono" FontSize="12" Text="{Binding StdDevText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="5" Classes="mono" FontSize="12" Text="{Binding FirstText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="6" Classes="mono" FontSize="12" Text="{Binding LastText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="7" Classes="mono" FontSize="12" Text="{Binding DeltaText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="8" Classes="mono" FontSize="12" Text="{Binding SamplesText}" />
                    <TextBlock Grid.Column="9" Classes="mono" FontSize="12" Text="{Binding EdgesText}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <v:ChartCanvas x:Name="Canvas" />
  </DockPanel>
  </Panel>
</UserControl>
