<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ch="using:PlcMonitor.App.Charts"
             xmlns:c="using:PlcMonitor.App.Controls"
             x:Class="PlcMonitor.App.Views.ChartPanel"
             x:DataType="ch:ChartViewModel">
  <!-- Gráfica con sus controles: tags a mostrar, límites del eje Y y zoom (arrastrar sobre la gráfica; «Ajustar» lo quita). -->
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,0,0,8">
      <ItemsControl ItemsSource="{Binding Options}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="ch:ChartSeriesOption">
            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,14,0">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <c:ChartSwatch ColorIndex="{Binding ColorIndex}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </StackPanel>
            </CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <CheckBox Content="Un eje por tag" IsChecked="{Binding SeparateAxes}" IsVisible="{Binding CanSeparateAxes}"
                  ToolTip.Tip="Cada tag con su propia escala, a la izquierda y con su color" />
        <CheckBox Content="{Binding AxisText}" IsChecked="{Binding AutoY}" IsVisible="{Binding HasYAxis}" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsManualY" />
              <Binding Path="HasYAxis" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="mín" Classes="muted" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding YMinInput}" Width="120" FormatString="0.###" Increment="1" />
          <TextBlock Text="máx" Classes="muted" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding YMaxInput}" Width="120" FormatString="0.###" Increment="1" />
        </StackPanel>
        <Button Classes="secondary" Command="{Binding ResetZoomCommand}" IsVisible="{Binding IsZoomed}" ToolTip.Tip="Quitar el zoom y ver toda la ventana">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Kind="maximize" />
            <TextBlock Text="Ajustar" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="2,4,0,0">
      <TextBlock Classes="muted" FontSize="11" Text="{Binding Hint}" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Classes="muted" FontSize="11" FontWeight="SemiBold" Text="{Binding Caption}" />
    </Grid>
    <Panel>
      <c:TrendChart x:Name="Chart" MinHeight="220" IsVisible="{Binding IsTrend}"
                    Series="{Binding Series}" From="{Binding From}" To="{Binding To}"
                    YMin="{Binding YMin}" YMax="{Binding YMax}" Revision="{Binding Revision}" EmptyText="{Binding EmptyText}"
                    SeparateAxes="{Binding SeparateAxes}" />
      <c:StateChart x:Name="States" MinHeight="220" IsVisible="{Binding IsStates}"
                    Series="{Binding Series}" From="{Binding From}" To="{Binding To}"
                    Revision="{Binding Revision}" EmptyText="{Binding EmptyText}" />
      <c:XYChart MinHeight="220" IsVisible="{Binding IsXY}"
                 Curves="{Binding Curves}" XLabel="{Binding XLabel}" ZeroLine="{Binding IsCycles}"
                 YMin="{Binding YMin}" YMax="{Binding YMax}" Revision="{Binding Revision}" EmptyText="{Binding EmptyText}" />
      <c:HistogramChart MinHeight="220" IsVisible="{Binding IsHistogram}"
                        Series="{Binding Series}" From="{Binding From}" To="{Binding To}"
                        LowLimit="{Binding LowLimit}" HighLimit="{Binding HighLimit}" XMin="{Binding YMin}" XMax="{Binding YMax}"
                        Revision="{Binding Revision}" EmptyText="{Binding EmptyText}" />
      <c:GaugePanel MinHeight="220" IsVisible="{Binding IsGauges}"
                    Series="{Binding Series}" From="{Binding From}" To="{Binding To}" StyleKind="{Binding GaugeStyle}"
                    LowLimit="{Binding LowLimit}" HighLimit="{Binding HighLimit}" ScaleMin="{Binding YMin}" ScaleMax="{Binding YMax}"
                    Revision="{Binding Revision}" EmptyText="{Binding EmptyText}" />
      <c:BarChart MinHeight="220" IsVisible="{Binding IsBars}"
                  Series="{Binding Series}" Period="{Binding BarPeriod}" ShiftStartHour="{Binding ShiftStartHour}"
                  YMin="{Binding YMin}" YMax="{Binding YMax}" Revision="{Binding Revision}" EmptyText="{Binding EmptyText}" />
    </Panel>
  </DockPanel>
</UserControl>
