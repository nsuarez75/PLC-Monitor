<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlcMonitor.App.ViewModels"
        xmlns:c="using:PlcMonitor.App.Controls"
        xmlns:v="using:PlcMonitor.App.Views"
        x:Class="PlcMonitor.App.Views.CsvViewerWindow"
        x:DataType="vm:CsvViewerViewModel"
        Title="{Binding Title, StringFormat='{}{0} · PLC-Monitor'}"
        Width="1100" Height="680" MinWidth="700" MinHeight="420"
        Background="{DynamicResource App.Background}">
  <!-- Visor sin conexión de un CSV exportado del histórico -->
  <DockPanel Margin="20,16">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="0,0,0,14">
      <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource App.AccentSoft}">
        <c:Icon Kind="chart" Width="20" Height="20" Foreground="{DynamicResource App.Accent}" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" Classes="title" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Button Grid.Column="2" Classes="secondary" Command="{Binding OpenCommand}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:Icon Kind="folder" />
          <TextBlock Text="Abrir otro CSV" />
        </StackPanel>
      </Button>
    </Grid>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Classes="error" TextWrapping="Wrap" Margin="0,0,0,10"
               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <Border Classes="card" Padding="16">
      <v:ChartAnalysisPanel DataContext="{Binding Analysis}" />
    </Border>
  </DockPanel>
</Window>
