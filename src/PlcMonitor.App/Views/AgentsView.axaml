<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:PlcMonitor.App.Localization"
             xmlns:vm="using:PlcMonitor.App.ViewModels"
             xmlns:svc="using:PlcMonitor.App.Services"
             xmlns:c="using:PlcMonitor.App.Controls"
             x:Class="PlcMonitor.App.Views.AgentsView"
             x:DataType="vm:AgentsViewModel"
             Background="{DynamicResource App.Background}">
  <Grid ColumnDefinitions="270,*" Margin="20,16" ColumnSpacing="16">

    <!-- Lista de agentes -->
    <Border Classes="card" Padding="12">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,0,0,10">
          <TextBlock Text="{loc:T 'AGENTES'}" Classes="caption" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost" Command="{Binding NewCommand}" ToolTip.Tip="{loc:T 'Nuevo agente'}">
            <c:Icon Kind="plus" />
          </Button>
        </Grid>
        <ListBox Classes="devices" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="svc:AgentProfile">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Url}" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ManagedLabel}" Classes="muted" FontSize="11.5" IsVisible="{Binding IsManaged}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Detalle del agente seleccionado -->
    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="14" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Name}" Classes="title" />
          <TextBlock Text="{Binding Info}" Classes="muted" />
        </StackPanel>

        <!-- Conexión -->
        <Border Classes="card" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="{loc:T 'CONEXIÓN'}" Classes="caption" />
            <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="16">
              <TextBlock Text="{loc:T 'Nombre'}" VerticalAlignment="Center" FontWeight="Medium" />
              <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="{loc:T 'Línea 3'}" />
              <TextBlock Grid.Row="1" Text="URL" VerticalAlignment="Center" FontWeight="Medium" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Url}" Classes="mono" PlaceholderText="{loc:T 'https://equipo:5311 (se rellena al instalar)'}" />
              <TextBlock Grid.Row="2" Text="Token" VerticalAlignment="Center" FontWeight="Medium" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Token}" PasswordChar="•" Classes="mono" PlaceholderText="{loc:T '(sin token)'}" />
              <TextBlock Grid.Row="3" Text="{loc:T 'Huella del certificado'}" VerticalAlignment="Center" FontWeight="Medium" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Thumbprint}" Classes="mono" FontSize="11.5" PlaceholderText="{loc:T '(sin TLS)'}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Equipo: este equipo o por SSH -->
        <Border Classes="card" Padding="20">
          <StackPanel Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:T 'EQUIPO'}" Classes="caption" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding MachineHelp}" />
            </StackPanel>
            <CheckBox Content="{loc:T 'Este equipo (sin SSH)'}" IsChecked="{Binding LocalMachine}" />
            <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="16" IsVisible="{Binding IsSsh}">
              <TextBlock Text="{loc:T 'Equipo'}" VerticalAlignment="Center" FontWeight="Medium" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding SshHost}" Width="260" PlaceholderText="{loc:T '192.168.0.20 o pc-linea'}" />
                <TextBlock Text="{loc:T 'puerto'}" Classes="muted" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding SshPort}" Minimum="1" Maximum="65535" FormatString="0" Width="120" />
              </StackPanel>
              <TextBlock Grid.Row="1" Text="{loc:T 'Usuario'}" VerticalAlignment="Center" FontWeight="Medium" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SshUser}" Width="260" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="2" Text="{loc:T 'Clave privada'}" VerticalAlignment="Center" FontWeight="Medium" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SshKeyFile}" Classes="mono" PlaceholderText="{loc:T '(opcional) por defecto ~/.ssh/id_ed25519, id_ecdsa o id_rsa'}" />
            </Grid>
            <Grid ColumnDefinitions="170,*" ColumnSpacing="16">
              <TextBlock Text="{loc:T 'Puerto del agente'}" VerticalAlignment="Center" FontWeight="Medium" />
              <NumericUpDown Grid.Column="1" Value="{Binding AgentPort}" Minimum="1" Maximum="65535" FormatString="0" Width="140" HorizontalAlignment="Left" />
            </Grid>

            <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Padding="14" Margin="0,4,0,0">
              <StackPanel Spacing="10">
                <TextBlock Text="{loc:T 'Para esta operación (no se guarda)'}" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="16">
                  <TextBlock Text="{loc:T 'Contraseña SSH / sudo'}" VerticalAlignment="Center" IsVisible="{Binding IsSsh}" />
                  <TextBox Grid.Column="1" Text="{Binding SshPassword}" PasswordChar="•" Width="260" HorizontalAlignment="Left" PlaceholderText="{loc:T 'vacía si entras con clave'}" IsVisible="{Binding IsSsh}" />
                  <TextBlock Grid.Row="1" Text="{loc:T 'Contraseña de sudo'}" VerticalAlignment="Center" IsVisible="{Binding ShowSudoPassword}" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SudoPassword}" PasswordChar="•" Width="260" HorizontalAlignment="Left" PlaceholderText="{Binding SudoPlaceholder}" IsVisible="{Binding ShowSudoPassword}" />
                  <TextBlock Grid.Row="2" Text="{loc:T 'Carpeta del agente'}" VerticalAlignment="Center" />
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PackageFolder}" Classes="mono" PlaceholderText="{loc:T '(por defecto el agente incluido en la app)'}" />
                </Grid>
                <WrapPanel Orientation="Horizontal">
                  <CheckBox Content="{loc:T 'Regenerar token y certificado'}" IsChecked="{Binding RegenerateCredentials}" Margin="0,0,20,4" />
                  <CheckBox Content="{loc:T 'Crear token de solo lectura'}" IsChecked="{Binding CreateReadOnlyToken}" Margin="0,0,20,4"
                            ToolTip.Tip="{loc:T 'Para quien solo debe ver: leer, tendencias e histórico, sin escribir ni configurar. Se crea al generar credenciales (instalación nueva, regenerar o renovar).'}" />
                  <CheckBox Content="{loc:T 'Conservar agent.json al desinstalar'}" IsChecked="{Binding KeepConfiguration}" Margin="0,0,20,4" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <WrapPanel Orientation="Horizontal">
              <Button Classes="accent" Command="{Binding InstallCommand}" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="server" />
                  <TextBlock Text="{loc:T 'Instalar / actualizar'}" />
                </StackPanel>
              </Button>
              <Button Classes="secondary" Command="{Binding RenewCredentialsCommand}" Margin="0,0,8,8"
                      ToolTip.Tip="{loc:T 'Token y certificado nuevos sin reinstalar: los anteriores dejan de valer.'}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="refresh" />
                  <TextBlock Text="{loc:T 'Renovar credenciales'}" />
                </StackPanel>
              </Button>
              <Button Classes="secondary" Command="{Binding StatusCommand}" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="pulse" />
                  <TextBlock Text="{loc:T 'Estado'}" />
                </StackPanel>
              </Button>
              <Button Classes="secondary" Command="{Binding LogsCommand}" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="list" />
                  <TextBlock Text="{loc:T 'Ver log'}" />
                </StackPanel>
              </Button>
              <Button Classes="secondary danger" Command="{Binding UninstallCommand}" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="trash" />
                  <TextBlock Text="{loc:T 'Desinstalar'}" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- Progreso / resultado -->
        <Border Classes="card" Padding="16" IsVisible="{Binding Log.Count, Converter={x:Static vm:Converters.IsPositive}}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{loc:T 'ACTIVIDAD'}" Classes="caption" VerticalAlignment="Center" />
              <ProgressBar IsIndeterminate="True" Width="120" Height="4" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Log}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <SelectableTextBlock Text="{Binding}" Classes="mono" FontSize="12" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="accent" Command="{Binding SaveCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="save" />
              <TextBlock Text="{loc:T 'Guardar'}" />
            </StackPanel>
          </Button>
          <Button Classes="ghost danger" Command="{Binding DeleteCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="trash" />
              <TextBlock Text="{loc:T 'Quitar de la lista'}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
