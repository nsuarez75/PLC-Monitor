<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlcMonitor.App.ViewModels"
        xmlns:c="using:PlcMonitor.App.Controls"
        xmlns:svc="using:PlcMonitor.App.Services"
        xmlns:v="using:PlcMonitor.App.Views"
        x:Class="PlcMonitor.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PLC-Monitor" Width="1320" Height="820" MinWidth="980" MinHeight="600">

  <DockPanel>
    <!-- ░░ Barra superior: marca, agente y estado de la conexión ░░ -->
    <Border DockPanel.Dock="Top" Classes="bar" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Classes="brand">
            <c:Icon Kind="pulse" Width="18" Height="18" Foreground="White" StrokeWidth="2.4" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="PLC-Monitor" FontWeight="Bold" FontSize="14" />
            <TextBlock Text="{Binding AgentDescription}" Classes="muted" FontSize="11" IsVisible="{Binding IsConnected}" />
            <TextBlock Text="Diagnóstico de PLCs Siemens S7" Classes="muted" FontSize="11" IsVisible="{Binding !IsConnected}" />
          </StackPanel>
        </StackPanel>

        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MaxWidth="320" MinWidth="120" HorizontalAlignment="Stretch"
                    IsEnabled="{Binding !IsConnected}" PlaceholderText="Elige un agente">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="svc:AgentProfile">
                <DockPanel>
                  <c:Icon DockPanel.Dock="Left" Kind="server" Width="14" Height="14" Margin="0,0,8,0" Foreground="{DynamicResource App.TextMuted}" />
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Url}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="1" Classes="accent" Command="{Binding ConnectCommand}" IsVisible="{Binding !IsConnected}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="link" />
              <TextBlock Text="Conectar" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="secondary" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="unlink" />
              <TextBlock Text="Desconectar" />
            </StackPanel>
          </Button>
        </Grid>

        <Border Grid.Column="2" Classes="pill" Padding="10,4"
                Classes.good="{Binding IsOnline}" Classes.warn="{Binding IsReconnecting}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Classes="dot" Classes.good="{Binding IsOnline}" Classes.warn="{Binding IsReconnecting}" />
            <TextBlock Text="{Binding ConnectionText}" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
        <Button Classes="ghost" Command="{Binding OpenTrendsCommand}" ToolTip.Tip="Gráficas de tags de cualquier dispositivo o de un CSV: en vivo, del histórico o del fichero">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Kind="pulse" Width="16" Height="16" />
            <TextBlock Text="Tendencias" Classes="barlabel" />
          </StackPanel>
        </Button>
        <Button Classes="ghost" Command="{Binding OpenAgentsCommand}" ToolTip.Tip="Gestionar agentes (instalar en equipos por SSH)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Kind="server" Width="16" Height="16" />
            <TextBlock Text="Agentes" Classes="barlabel" />
          </StackPanel>
        </Button>
        <Button Classes="ghost" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeText, StringFormat='Tema: {0}'}">
          <c:Icon Kind="{Binding ThemeIcon}" Width="18" Height="18" />
        </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ░░ Barra de estado ░░ -->
    <Border DockPanel.Dock="Bottom" Classes="bar" BorderThickness="0,1,0,0" Padding="16,7">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <c:Icon Kind="alert" Width="14" Height="14" Foreground="{DynamicResource App.Bad}" IsVisible="{Binding IsMessageError}" />
        <c:Icon Kind="info" Width="14" Height="14" Foreground="{DynamicResource App.TextMuted}" IsVisible="{Binding !IsMessageError}" />
        <TextBlock Text="{Binding Message}" Classes="muted" Classes.error="{Binding IsMessageError}" TextTrimming="CharacterEllipsis" FontSize="12" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="280,*">
      <!-- ░░ Lateral: dispositivos ░░ -->
      <Border Classes="bar" BorderThickness="0,0,1,0">
        <DockPanel Margin="12,14,12,12">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,0,0,10">
            <TextBlock Text="DISPOSITIVOS" Classes="caption" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost" Command="{Binding NewDeviceCommand}" ToolTip.Tip="Nuevo dispositivo">
              <c:Icon Kind="plus" />
            </Button>
          </Grid>
          <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="4,8" FontSize="12"
                     IsVisible="{Binding !IsConnected}" Text="Conecta con un agente para ver sus PLC." />
          <ListBox Classes="devices" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DeviceViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="2">
                  <Border Grid.RowSpan="2" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource App.SurfaceAlt}">
                    <c:Icon Kind="cpu" Width="18" Height="18" Foreground="{DynamicResource App.TextMuted}" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                  <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="6">
                    <Ellipse Classes="dot" Width="7" Height="7" Classes.good="{Binding IsConnected}"
                             Classes.warn="{Binding IsConnecting}" Classes.bad="{Binding IsFaulted}" />
                    <TextBlock Text="{Binding StateText}" Classes="muted" FontSize="11.5" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Grid.RowSpan="2" Text="{Binding Tags.Count}" Classes="muted" FontSize="11.5" VerticalAlignment="Center"
                             ToolTip.Tip="{Binding TagCountText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- ░░ Contenido ░░ -->
      <Panel Grid.Column="1">
        <!-- Vacío: sin dispositivo seleccionado -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                    IsVisible="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNull}}">
          <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource App.AccentSoft}" HorizontalAlignment="Center">
            <c:Icon Kind="server" Width="26" Height="26" Foreground="{DynamicResource App.Accent}" />
          </Border>
          <TextBlock Text="Ningún dispositivo seleccionado" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                     Text="Conecta con un agente y elige un PLC, o da de alta uno nuevo con el botón +." />
        </StackPanel>

        <!-- Dispositivo seleccionado -->
        <DockPanel Margin="20,16,20,16" IsVisible="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14" DataContext="{Binding SelectedDevice}" x:DataType="vm:DeviceViewModel">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Name}" Classes="title" />
                <Border Classes="pill" Classes.good="{Binding IsConnected}" Classes.warn="{Binding IsConnecting}" Classes.bad="{Binding IsFaulted}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Classes="dot" Width="7" Height="7" Classes.good="{Binding IsConnected}" Classes.warn="{Binding IsConnecting}" Classes.bad="{Binding IsFaulted}" />
                    <TextBlock Text="{Binding StateText}" />
                  </StackPanel>
                </Border>
                <Border Classes="pill accent" IsVisible="{Binding WritesEnabled}">
                  <TextBlock Text="Escritura habilitada" />
                </Border>
              </StackPanel>
              <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12">
                <Run Text="{Binding Driver}" /><Run Text="  ·  desde " /><Run Text="{Binding Since}" /><Run Text="  " /><Run Text="{Binding Detail}" />
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
              <Button Classes="secondary" Command="{Binding ToggleEnabledCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="power" />
                  <TextBlock Text="{Binding ToggleText}" />
                </StackPanel>
              </Button>
              <Button Classes="secondary" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditDeviceCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="pencil" />
                  <TextBlock Text="Editar" />
                </StackPanel>
              </Button>
              <Button Classes="ghost danger" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteDeviceCommand}" ToolTip.Tip="Eliminar dispositivo">
                <c:Icon Kind="trash" />
              </Button>
            </StackPanel>
          </Grid>

          <TabControl Classes="compact">
            <!-- Tags en vivo -->
            <TabItem>
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Tags" />
                  <Border Classes="pill" Padding="7,0">
                    <TextBlock Text="{Binding SelectedDevice.Tags.Count, FallbackValue=0}" />
                  </Border>
                </StackPanel>
              </TabItem.Header>
              <DockPanel Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10"
                            DataContext="{Binding SelectedDevice}" x:DataType="vm:DeviceViewModel" IsVisible="{Binding HasTags, FallbackValue=False}">
                  <Border Classes="pill good">
                    <TextBlock><Run Text="{Binding GoodCount}" /><Run Text=" en buen estado" /></TextBlock>
                  </Border>
                  <Border Classes="pill bad" IsVisible="{Binding HasBadTags}">
                    <TextBlock><Run Text="{Binding BadCount}" /><Run Text=" con error" /></TextBlock>
                  </Border>
                </StackPanel>

                <Border Classes="card" ClipToBounds="True">
                  <DockPanel>
                    <c:TableRow DockPanel.Dock="Top" Classes="tablehead" Columns="2*,2.2*,1.6*,90,130,100,250" HideOrder="3,5,1" MinStarWidth="45" ColumnSpacing="12" Margin="16,12,16,10">
                      <TextBlock Text="TAG" />
                      <TextBlock Grid.Column="1" Text="DIRECCIÓN" />
                      <TextBlock Grid.Column="2" Text="VALOR" />
                      <TextBlock Grid.Column="3" Text="TIPO" />
                      <TextBlock Grid.Column="4" Text="CALIDAD" />
                      <TextBlock Grid.Column="5" Text="ACTUALIZADO" />
                      <TextBlock Grid.Column="6" Text="ESCRIBIR" />
                    </c:TableRow>
                    <StackPanel DockPanel.Dock="Top" Margin="16,24" Spacing="6" HorizontalAlignment="Center"
                                IsVisible="{Binding !SelectedDevice.HasTags, FallbackValue=False}">
                      <TextBlock Text="Sin tags" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Classes="muted" Text="Añádelos desde la pestaña «Explorar» con el PLC conectado." HorizontalAlignment="Center" />
                    </StackPanel>
                    <ListBox x:Name="TagsList" Classes="table" ItemsSource="{Binding SelectedDevice.Tags}" ToolTip.Tip="Doble clic para ver el detalle y la configuración del tag">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TagViewModel">
                          <c:TableRow Columns="2*,2.2*,1.6*,90,130,100,250" HideOrder="3,5,1" MinStarWidth="45" ColumnSpacing="12">
                            <StackPanel VerticalAlignment="Center">
                              <DockPanel>
                                <c:Icon DockPanel.Dock="Left" Kind="history" Width="13" Height="13" Margin="0,0,6,0" Foreground="{DynamicResource App.Accent}"
                                        IsVisible="{Binding Historized}" ToolTip.Tip="Se guarda en el histórico" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                              </DockPanel>
                              <TextBlock Text="{Binding Group}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Address}" Classes="muted mono" FontSize="12" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" ToolTip.Tip="{Binding Address}" />
                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" Classes="mono" FontSize="13.5" FontWeight="SemiBold"
                                       Classes.error="{Binding IsBad}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding ValueText}" />
                            <TextBlock Grid.Column="3" Text="{Binding DataType}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="4" Classes="pill" HorizontalAlignment="Left" Classes.good="{Binding IsGood}" Classes.warn="{Binding IsUncertain}" Classes.bad="{Binding IsBad}">
                              <TextBlock Text="{Binding Quality}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Quality}" />
                            </Border>
                            <TextBlock Grid.Column="5" Text="{Binding Time}" Classes="muted mono" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                              <TextBox Text="{Binding NewValue}" Width="120" IsVisible="{Binding ShowTextWrite}" PlaceholderText="nuevo valor" Classes="mono" />
                              <Button Classes="accent" Padding="9,6" Command="{Binding WriteCommand}" IsVisible="{Binding ShowTextWrite}" ToolTip.Tip="Escribir">
                                <c:Icon Kind="send" Width="14" Height="14" />
                              </Button>
                              <!-- Booleanos: el botón del valor actual va encendido; el otro escribe ese valor -->
                              <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowBoolWrite}">
                                <Button Classes="seg left" Classes.on="{Binding IsFalse}" IsHitTestVisible="{Binding !IsFalse}"
                                        Command="{Binding WriteBoolCommand}" CommandParameter="false" Content="false" ToolTip.Tip="Escribir false" />
                                <Button Classes="seg right" Classes.on="{Binding IsTrue}" IsHitTestVisible="{Binding !IsTrue}"
                                        Command="{Binding WriteBoolCommand}" CommandParameter="true" Content="true" ToolTip.Tip="Escribir true" />
                              </StackPanel>
                              <Button Classes="ghost danger" Command="{Binding RemoveCommand}" ToolTip.Tip="Quitar tag">
                                <c:Icon Kind="x" Width="14" Height="14" />
                              </Button>
                            </StackPanel>
                          </c:TableRow>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </Border>
              </DockPanel>
            </TabItem>

            <!-- Histórico -->
            <TabItem Header="Histórico">
              <DockPanel Margin="0,12,0,0" DataContext="{Binding History}" x:DataType="vm:HistoryViewModel">
                <Border DockPanel.Dock="Top" Classes="card" Padding="14" Margin="0,0,0,12">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasHistorizedTags}"
                               Text="Este dispositivo no tiene tags historizados. Actívalo en un tag con doble clic → Histórico." />
                    <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasHistorizedTags}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryTagOption">
                          <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,16,0" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <ComboBox ItemsSource="{x:Static vm:HistoryViewModel.Ranges}" SelectedItem="{Binding Range}" MinWidth="160" />
                      <ComboBox ItemsSource="{x:Static vm:HistoryViewModel.Aggregates}" SelectedItem="{Binding Aggregate}" MinWidth="130" />
                      <TextBlock Text="cada" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding IsAggregated}" />
                      <ComboBox ItemsSource="{x:Static vm:HistoryViewModel.Intervals}" SelectedItem="{Binding Interval}" MinWidth="100" IsVisible="{Binding IsAggregated}" />
                      <Button Classes="accent" Command="{Binding QueryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <c:Icon Kind="search" />
                          <TextBlock Text="Consultar" />
                        </StackPanel>
                      </Button>
                      <Button Classes="secondary" Command="{Binding ExportCommand}" ToolTip.Tip="Exportar a CSV">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <c:Icon Kind="download" />
                          <TextBlock Text="CSV" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,0,0,8">
                  <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                  <CheckBox Grid.Column="1" Content="Ver tabla" IsChecked="{Binding ShowTable}" />
                </Grid>

                <Panel>
                <Border Classes="card" Padding="16" IsVisible="{Binding !ShowTable}">
                  <v:ChartAnalysisPanel DataContext="{Binding Analysis}" MinHeight="320" />
                </Border>

                <Border Classes="card" ClipToBounds="True" IsVisible="{Binding ShowTable}">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" Classes="tablehead" ColumnDefinitions="200,2*,2*,150" ColumnSpacing="12" Margin="16,12,16,10">
                      <TextBlock Text="HORA" />
                      <TextBlock Grid.Column="1" Text="TAG" />
                      <TextBlock Grid.Column="2" Text="VALOR" />
                      <TextBlock Grid.Column="3" Text="CALIDAD" />
                    </Grid>
                    <ListBox Classes="table" ItemsSource="{Binding Rows}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryRowViewModel">
                          <Grid ColumnDefinitions="200,2*,2*,150" ColumnSpacing="12">
                            <TextBlock Text="{Binding Time}" Classes="muted mono" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Tag}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Value}" Classes="mono" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="3" Classes="pill" Classes.good="{Binding IsGood}" Classes.bad="{Binding IsBad}">
                              <TextBlock Text="{Binding Quality}" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </Border>
                </Panel>
              </DockPanel>
            </TabItem>

            <!-- Explorador de símbolos -->
            <TabItem Header="Explorar">
              <DockPanel Margin="0,12,0,0" DataContext="{Binding Browse}" x:DataType="vm:BrowseViewModel">
                <Border DockPanel.Dock="Top" Classes="card" Padding="14" Margin="0,0,0,12">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                      <TextBox Text="{Binding Filter}" PlaceholderText="Buscar símbolos por nombre (vacío = todos)">
                        <TextBox.InnerLeftContent>
                          <c:Icon Kind="search" Margin="10,0,2,0" Foreground="{DynamicResource App.TextMuted}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                      <NumericUpDown Grid.Column="1" Value="{Binding MaxResults}" Minimum="10" Maximum="100000" Increment="100" FormatString="0" Width="130"
                                     ToolTip.Tip="Máximo de resultados" />
                      <Button Grid.Column="2" Classes="accent" Command="{Binding SearchCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <c:Icon Kind="search" />
                          <TextBlock Text="Buscar" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="3" Classes="secondary" Command="{Binding RefreshCommand}" ToolTip.Tip="Volver a explorar la CPU (tras cargar un programa nuevo)">
                        <c:Icon Kind="refresh" />
                      </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="Añadir al grupo" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Text="{Binding GroupName}" Width="140" />
                      <TextBlock Text="cada" Classes="muted" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding IntervalMs}" Minimum="50" Increment="250" FormatString="0" Width="130" />
                      <TextBlock Text="ms (si el grupo es nuevo)" Classes="muted" VerticalAlignment="Center" />
                      <CheckBox Content="Escribible" IsChecked="{Binding AddWritable}" Margin="8,0,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Classes="muted" FontSize="12" Margin="2,0,0,8" />

                <Border Classes="card" ClipToBounds="True">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" Classes="tablehead" ColumnDefinitions="*,140,110,Auto" ColumnSpacing="12" Margin="16,12,16,10">
                      <TextBlock Text="SÍMBOLO" />
                      <TextBlock Grid.Column="1" Text="TIPO PLC" />
                      <TextBlock Grid.Column="2" Text="TIPO" />
                      <TextBlock Grid.Column="3" Text="" Width="96" />
                    </Grid>
                    <ListBox Classes="table" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedItem}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:BrowseItemViewModel">
                          <Grid ColumnDefinitions="*,140,110,Auto" ColumnSpacing="12">
                            <TextBlock Text="{Binding Address}" Classes="mono" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding NativeType}" Classes="muted" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding DataType}" Classes="muted" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Classes="secondary" Padding="10,4" Width="96" IsVisible="{Binding !IsAdded}"
                                    Command="{Binding $parent[ListBox].((vm:BrowseViewModel)DataContext).AddCommand}" CommandParameter="{Binding}">
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <c:Icon Kind="plus" Width="14" Height="14" />
                                <TextBlock Text="Añadir" />
                              </StackPanel>
                            </Button>
                            <Border Grid.Column="3" Classes="pill good" Width="96" IsVisible="{Binding IsAdded}" ToolTip.Tip="Ya es un tag de este dispositivo">
                              <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <c:Icon Kind="check" Width="12" Height="12" Foreground="{DynamicResource App.Good}" />
                                <TextBlock Text="Añadido" />
                              </StackPanel>
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </Border>
              </DockPanel>
            </TabItem>
          </TabControl>
        </DockPanel>

        <!-- Vistas de tendencia (por encima del contenido) -->
        <v:TrendsView DataContext="{Binding Trends}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Trends, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Gestión de agentes (por encima del contenido) -->
        <v:AgentsView DataContext="{Binding Agents}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Agents, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Editor de dispositivo (por encima del contenido) -->
        <Border Background="{DynamicResource App.Background}" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
          <ScrollViewer>
            <Border Classes="card" Margin="24" Padding="24" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
              <StackPanel Spacing="16" DataContext="{Binding Editor}" x:DataType="vm:DeviceEditorViewModel">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" Classes="title" />
                  <TextBlock Text="Los cambios se guardan en la configuración del agente." Classes="muted" />
                </StackPanel>
                <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="14" ColumnSpacing="16">
                  <TextBlock Text="Nombre" VerticalAlignment="Center" FontWeight="Medium" />
                  <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="prensa1" />
                  <TextBlock Grid.Row="1" Text="Driver" VerticalAlignment="Center" FontWeight="Medium" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding DriverIds}" SelectedItem="{Binding DriverId}" MinWidth="240" />
                  <StackPanel Grid.Row="2" Spacing="2" Margin="0,6,0,0">
                    <TextBlock Text="Ajustes" FontWeight="Medium" />
                    <TextBlock Text="JSON del driver" Classes="muted" FontSize="11.5" />
                  </StackPanel>
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SettingsJson}" AcceptsReturn="True" Classes="mono" MinHeight="150" FontSize="12.5" />
                  <TextBlock Grid.Row="3" Text="Opciones" VerticalAlignment="Center" FontWeight="Medium" />
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="20">
                    <CheckBox Content="Activo" IsChecked="{Binding Enabled}" />
                    <CheckBox Content="Escrituras habilitadas (1.ª llave)" IsChecked="{Binding WritesEnabled}" />
                  </StackPanel>
                  <StackPanel Grid.Row="4" Spacing="2">
                    <TextBlock Text="Reconexión" FontWeight="Medium" />
                    <TextBlock Text="espera inicial, máxima y factor" Classes="muted" FontSize="11.5" />
                  </StackPanel>
                  <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <NumericUpDown Value="{Binding InitialDelayMs}" Minimum="100" Increment="500" FormatString="0" Width="130" />
                    <TextBlock Text="ms" Classes="muted" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding MaxDelayMs}" Minimum="100" Increment="1000" FormatString="0" Width="140" Margin="8,0,0,0" />
                    <TextBlock Text="ms" Classes="muted" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding Multiplier}" Minimum="1" Increment="0.5" FormatString="0.0" Width="110" Margin="8,0,0,0" />
                    <TextBlock Text="×" Classes="muted" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding TagSummary}" Classes="muted" IsVisible="{Binding !IsNew}" />
                <Border Classes="pill bad" CornerRadius="8" Padding="12,8" IsVisible="{Binding Errors, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        HorizontalAlignment="Stretch">
                  <TextBlock Text="{Binding Errors}" TextWrapping="Wrap" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="accent" Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Icon Kind="save" />
                      <TextBlock Text="Guardar" />
                    </StackPanel>
                  </Button>
                  <Button Classes="secondary" Content="Cancelar" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseEditorCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Border>
      </Panel>
    </Grid>
  </DockPanel>
</Window>
