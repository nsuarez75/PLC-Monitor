<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlcMonitor.App.ViewModels"
        x:Class="PlcMonitor.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PLC-Monitor" Width="1280" Height="800" MinWidth="900" MinHeight="560">

  <DockPanel>
    <!-- Conexión con el agente -->
    <Border DockPanel.Dock="Top" Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="Auto,320,Auto,Auto,*,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="Agente" VerticalAlignment="Center" FontWeight="SemiBold" />
        <AutoCompleteBox Grid.Column="1" Text="{Binding AgentUrl}" ItemsSource="{Binding RecentAgents}"
                         IsEnabled="{Binding !IsConnected}" PlaceholderText="http://127.0.0.1:5310" MinimumPrefixLength="0" />
        <Button Grid.Column="2" Content="Conectar" Command="{Binding ConnectCommand}" Classes="accent" IsVisible="{Binding !IsConnected}" />
        <Button Grid.Column="3" Content="Desconectar" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}" />
        <TextBlock Grid.Column="4" Text="{Binding AgentDescription}" VerticalAlignment="Center" Classes="muted" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="5" Text="{Binding ConnectionText}" VerticalAlignment="Center" FontWeight="SemiBold" />
      </Grid>
    </Border>

    <!-- Barra de mensajes -->
    <Border DockPanel.Dock="Bottom" Padding="12,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <TextBlock Text="{Binding Message}" Classes.error="{Binding IsMessageError}" TextTrimming="CharacterEllipsis" />
    </Border>

    <Grid ColumnDefinitions="300,4,*">
      <!-- Dispositivos -->
      <DockPanel Grid.Column="0" Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Dispositivos" Classes="header" Margin="0,0,0,6" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
          <Button Content="Nuevo" Command="{Binding NewDeviceCommand}" />
          <Button Content="Editar" Command="{Binding EditDeviceCommand}" />
          <Button Content="Eliminar" Command="{Binding DeleteDeviceCommand}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DeviceViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                <Ellipse Grid.RowSpan="2" Classes="state" Classes.connected="{Binding IsConnected}"
                         Classes.connecting="{Binding IsConnecting}" Classes.faulted="{Binding IsFaulted}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Grid.RowSpan="2" Content="{Binding ToggleText}" Command="{Binding ToggleEnabledCommand}"
                        Padding="8,2" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Grid.Row="1" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding StateText}" /><Run Text=" · " /><Run Text="{Binding Driver}" />
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

      <!-- Editor de dispositivo (alta o edición) -->
      <ScrollViewer Grid.Column="2" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Margin="16" Spacing="10" MaxWidth="720" HorizontalAlignment="Left" DataContext="{Binding Editor}" x:DataType="vm:DeviceEditorViewModel">
          <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
            <TextBlock Text="Nombre" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="prensa1" />
            <TextBlock Grid.Row="1" Text="Driver" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding DriverIds}" SelectedItem="{Binding DriverId}" MinWidth="220" />
            <TextBlock Grid.Row="2" Text="Ajustes del driver (JSON)" VerticalAlignment="Top" Margin="0,6,0,0" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SettingsJson}" AcceptsReturn="True" FontFamily="monospace" MinHeight="140" />
            <TextBlock Grid.Row="3" Text="Estado" VerticalAlignment="Center" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="16">
              <CheckBox Content="Activo" IsChecked="{Binding Enabled}" />
              <CheckBox Content="Escrituras habilitadas (1.ª llave)" IsChecked="{Binding WritesEnabled}" />
            </StackPanel>
            <TextBlock Grid.Row="4" Text="Reconexión" VerticalAlignment="Center" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <NumericUpDown Value="{Binding InitialDelayMs}" Minimum="100" Increment="500" FormatString="0" Width="130" />
              <TextBlock Text="ms inicial · máx." VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding MaxDelayMs}" Minimum="100" Increment="1000" FormatString="0" Width="140" />
              <TextBlock Text="ms · ×" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding Multiplier}" Minimum="1" Increment="0.5" FormatString="0.0" Width="110" />
            </StackPanel>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TagSummary}" Classes="muted" />
          </Grid>
          <TextBlock Text="{Binding Errors}" Classes="error" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Guardar" Command="{Binding SaveCommand}" Classes="accent" />
            <Button Content="Cancelar" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseEditorCommand}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Tags y explorador del dispositivo seleccionado -->
      <TabControl Grid.Column="2" Margin="8,4" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNull}}">
        <TabItem Header="Tags">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="4,0,4,8" Spacing="2" DataContext="{Binding SelectedDevice}" x:DataType="vm:DeviceViewModel">
              <TextBlock FontSize="18" FontWeight="SemiBold">
                <Run Text="{Binding Name}" /><Run Text="  " /><Run Text="{Binding StateText}" FontSize="14" FontWeight="Normal" />
              </TextBlock>
              <TextBlock Classes="muted" TextWrapping="Wrap">
                <Run Text="Desde " /><Run Text="{Binding Since}" /><Run Text="  " /><Run Text="{Binding Detail}" />
              </TextBlock>
            </StackPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,2*,1.6*,80,150,90,260" Margin="12,0,12,4" ColumnSpacing="8">
              <TextBlock Text="Tag" Classes="header" />
              <TextBlock Grid.Column="1" Text="Dirección" Classes="header" />
              <TextBlock Grid.Column="2" Text="Valor" Classes="header" />
              <TextBlock Grid.Column="3" Text="Tipo" Classes="header" />
              <TextBlock Grid.Column="4" Text="Calidad" Classes="header" />
              <TextBlock Grid.Column="5" Text="Hora" Classes="header" />
              <TextBlock Grid.Column="6" Text="Escribir" Classes="header" />
            </Grid>
            <TextBlock DockPanel.Dock="Top" Margin="12,8" Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNull}}"
                       Text="Conecta con un agente y selecciona un dispositivo. Con «Nuevo» se da de alta un PLC." />
            <TextBlock DockPanel.Dock="Top" Margin="12,8" Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding SelectedDevice.Tags.Count, FallbackValue=False, Converter={x:Static vm:Converters.IsZero}}"
                       Text="Este dispositivo no tiene tags. Añádelos desde la pestaña «Explorar» (con el PLC conectado)." />
            <ListBox ItemsSource="{Binding SelectedDevice.Tags}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TagViewModel">
                  <Grid ColumnDefinitions="2*,2*,1.6*,80,150,90,260" ColumnSpacing="8">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Group}" Classes="muted" FontSize="11" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Address}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Address}" />
                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               FontFamily="monospace" ToolTip.Tip="{Binding ValueText}" />
                    <TextBlock Grid.Column="3" Text="{Binding DataType}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding Quality}" Classes="quality" Classes.good="{Binding IsGood}"
                               Classes.uncertain="{Binding IsUncertain}" Classes.bad="{Binding IsBad}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="5" Text="{Binding Time}" Classes="muted" VerticalAlignment="Center" FontSize="12" />
                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4">
                      <TextBox Text="{Binding NewValue}" Width="110" IsVisible="{Binding Writable}" PlaceholderText="valor" />
                      <Button Content="Escribir" Command="{Binding WriteCommand}" IsVisible="{Binding Writable}" Padding="8,2" />
                      <Button Content="Quitar" Command="{Binding RemoveCommand}" Padding="8,2" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>

        <TabItem Header="Explorar">
          <DockPanel DataContext="{Binding Browse}" x:DataType="vm:BrowseViewModel" Margin="4">
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding Filter}" PlaceholderText="Texto del nombre (vacío = todo)">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" CommandParameter="False" />
                  </TextBox.KeyBindings>
                </TextBox>
                <NumericUpDown Grid.Column="1" Value="{Binding MaxResults}" Minimum="10" Maximum="100000" Increment="100" FormatString="0" Width="130" />
                <Button Grid.Column="2" Content="Buscar" Command="{Binding SearchCommand}" CommandParameter="False" Classes="accent" />
                <Button Grid.Column="3" Content="Volver a explorar la CPU" Command="{Binding SearchCommand}" CommandParameter="True" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Añadir al grupo" VerticalAlignment="Center" />
                <TextBox Text="{Binding GroupName}" Width="140" />
                <TextBlock Text="periodo (si es nuevo)" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding IntervalMs}" Minimum="50" Increment="250" FormatString="0" Width="130" />
                <TextBlock Text="ms" VerticalAlignment="Center" />
                <CheckBox Content="Escribible (2.ª llave)" IsChecked="{Binding AddWritable}" />
              </StackPanel>
              <TextBlock Text="{Binding Summary}" Classes="muted" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedItem}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BrowseItemViewModel">
                  <Grid ColumnDefinitions="*,120,100,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Address}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding NativeType}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding DataType}" Classes="muted" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="Añadir" Padding="8,2"
                            Command="{Binding $parent[ListBox].((vm:BrowseViewModel)DataContext).AddCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
