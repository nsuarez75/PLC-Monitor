<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>plcmon-app</AssemblyName>
    <Description>Aplicación de escritorio de PLC-Monitor (cliente del agente).</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Código generado por Avalonia y CommunityToolkit.Mvvm -->
    <NoWarn>$(NoWarn);CA1822;CA1852</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PlcMonitor.Agent.Contracts\PlcMonitor.Agent.Contracts.csproj" />
    <ProjectReference Include="..\PlcMonitor.Deploy\PlcMonitor.Deploy.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PlcMonitor.App.Tests" />
  </ItemGroup>
  <!-- Release: los agentes de todas las plataformas van dentro de la app (plcmon-agent-<rid> en PlcMonAgentsDir),
       así la app instala el agente en cualquier equipo sin más ficheros. Ver scripts/publish-release.sh. -->
  <ItemGroup Condition="'$(PlcMonAgentsDir)' != ''">
    <EmbeddedResource Include="$(PlcMonAgentsDir)/plcmon-agent-*" LogicalName="agents/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
