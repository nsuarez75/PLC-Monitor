{
  "Agent": {
    // Dispositivos y tags. Relativo a la carpeta del ejecutable.
    "ConfigPath": "agent.json"
  },
  "Kestrel": {
    "Endpoints": {
      // Solo local por defecto. Para aceptar conexiones remotas usa http://0.0.0.0:5310
      // (la API aún no tiene autenticación: ver docs/manual).
      "Grpc": { "Url": "http://127.0.0.1:5310" }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "PlcMonitor.Audit": "Information"
    }
  }
}
