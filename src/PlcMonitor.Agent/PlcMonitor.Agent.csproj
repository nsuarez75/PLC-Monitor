<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>plcmon-agent</AssemblyName>
    <Description>Agente de PLC-Monitor: servicio que vigila los dispositivos y los expone por gRPC y OPC UA.</Description>
    <!-- Solo gRPC: sin ficheros estáticos (así el publicado es un único ejecutable). -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PlcMonitor.Agent.Contracts\PlcMonitor.Agent.Contracts.csproj" />
    <ProjectReference Include="..\PlcMonitor.Engine\PlcMonitor.Engine.csproj" />
    <ProjectReference Include="..\PlcMonitor.Historian\PlcMonitor.Historian.csproj" />
    <ProjectReference Include="..\PlcMonitor.OpcUa\PlcMonitor.OpcUa.csproj" />
    <ProjectReference Include="..\PlcMonitor.Drivers.S7Absolute\PlcMonitor.Drivers.S7Absolute.csproj" />
    <ProjectReference Include="..\PlcMonitor.Drivers.S7Symbolic\PlcMonitor.Drivers.S7Symbolic.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PlcMonitor.Agent.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="agent.sample.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
